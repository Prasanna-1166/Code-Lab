# Copy this file to ".env" for local development (netlify dev reads it).
# In production, set the same names in Netlify: Site configuration > Environment variables.
# These are placeholders only. Never commit real values.

# The password you type on the admin page.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# A long random string (32+ characters) used to sign admin sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
